# Server
NODE_ENV=development
PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_management?schema=public

# JWT secrets (use strong random strings in production)
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie settings (COOKIE_SECURE=false for local HTTP; true only behind HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS — must match frontend origin when credentials/cookies are used (do not use *)
CORS_ORIGIN=http://localhost:5173

# Pending online booking hold (minutes) before expiry frees the room
BOOKING_PENDING_TTL_MINUTES=30

# Stripe (use test keys locally)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=usd

# Email (Nodemailer / SMTP — start Mailhog via `docker compose up -d mailhog`)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hotel.local
HOTEL_NAME=Grand Hotel

# Cloudinary — server-side room-type image uploads (Multer → Cloudinary)
# Prefer CLOUDINARY_URL, or set the three discrete vars below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

